# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=3000

# --- Database (PostgreSQL) ---
# Password used by docker-compose.yml to create the local database.
POSTGRES_PASSWORD=change-me
# Must use the same password as above when running against docker-compose.
DATABASE_URL=postgresql://insureflow_app:change-me@localhost:5432/insureflow?schema=public

# --- Auth ---
# Secret used to sign JWT access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- NestJS Observe (optional) ---
# Written for you by `npx @nestjs/observe link`.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
