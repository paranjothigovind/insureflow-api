
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AGENT
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  role         UserRole @default(AGENT)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  agent Agent?

  @@map("users")
}

model Agent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(150)
  phone     String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  customers Customer[]

  @@map("agents")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  agentId   String   @map("agent_id") @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(150)
  email     String   @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  agent    Agent    @relation(fields: [agentId], references: [id], onDelete: Restrict)
  policies Policy[]

  @@index([agentId])
  @@map("customers")
}

model PolicyProduct {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(150)
  description    String?
  annualPremium  Decimal  @map("annual_premium") @db.Decimal(12, 2)
  coverageAmount Decimal  @map("coverage_amount") @db.Decimal(14, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  policies Policy[]

  @@map("policy_products")
}

model Policy {
  id              String       @id @default(uuid()) @db.Uuid
  policyNumber    String       @unique @map("policy_number") @db.VarChar(40)
  customerId      String       @map("customer_id") @db.Uuid
  productId       String       @map("product_id") @db.Uuid
  startDate       DateTime     @map("start_date") @db.Date
  endDate         DateTime     @map("end_date") @db.Date
  premiumAmount   Decimal      @map("premium_amount") @db.Decimal(12, 2)
  coverageAmount  Decimal      @map("coverage_amount") @db.Decimal(14, 2)
  status          PolicyStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")

  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product  PolicyProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([customerId])
  @@index([productId])
  @@index([status, endDate])
  @@map("policies")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  policyId      String        @map("policy_id") @db.Uuid
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  transactionRef String?      @unique @map("transaction_ref") @db.VarChar(100)
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@index([policyId, status])
  @@map("payments")
}
